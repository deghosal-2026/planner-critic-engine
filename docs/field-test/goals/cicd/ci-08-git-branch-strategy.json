{
  "id": "ci-08-git-branch-strategy",
  "description": "Git branch strategy enforcement: feature branch from main → PR with required checks → squash merge → delete source branch. Automate branch protection rules across all repos.",
  "constraints": {
    "environment": "production",
    "tools": ["git", "github-actions", "github-api"],
    "branch_protection": {
      "required_reviews": 1,
      "dismiss_stale_reviews": true,
      "required_status_checks": ["ci/lint", "ci/test", "ci/build"],
      "require_signed_commits": false,
      "delete_branch_on_merge": true
    },
    "merge_strategy": "squash"
  },
  "risk_tolerance": "balanced",
  "replan_policy": "patch"
}