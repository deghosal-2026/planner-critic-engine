{
  "id": "ci-03-canary-launchdarkly",
  "description": "Canary release orchestrated via LaunchDarkly: enable flag at 5% for beta users → monitor metrics → ramp to 25%, 50%, 100% or auto-rollback on error spike.",
  "mandatory": ["verification", "rollback"],
  "constraints": {
    "environment": "production",
    "tools": ["git", "docker", "kubectl", "launchdarkly", "datadog", "pagerduty"],
    "canary_steps": ["5-percent", "25-percent", "50-percent", "100-percent"],
    "observation_window_minutes": 10,
    "metric_thresholds": {
      "error_rate_pct": 1.0,
      "p99_latency_ms": 500,
      "throughput_drop_pct": 10
    }
  },
  "risk_tolerance": "balanced",
  "replan_policy": "patch"
}