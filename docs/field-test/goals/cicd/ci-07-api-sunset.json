{
  "id": "ci-07-api-sunset",
  "description": "Sunset API v1: deprecate with Sunset header → notify known consumers → redirect traffic to v2 → monitor for orphaned calls → remove v1 code. Full rollback capability at each step.",
  "mandatory": ["verification", "rollback"],
  "constraints": {
    "environment": "production",
    "tools": ["git", "kubectl", "terraform", "datadog", "slack", "pagerduty"],
    "sunset_timeline_days": 90,
    "phases": ["deprecate-announce", "notify-consumers", "redirect-traffic", "monitor-orphans", "remove-code"],
    "notification_channels": ["email", "slack", "api-email"]
  },
  "risk_tolerance": "strict",
  "replan_policy": "restart"
}