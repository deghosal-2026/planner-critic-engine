{
  "id": "ci-05-ci-runner-scaling",
  "description": "Scale GitHub Actions self-hosted runners: implement auto-scaling group on EC2 → configure runner registration → handle scale-up on demand and scale-down on idle. Ensure zero job queue backlog during peak.",
  "constraints": {
    "environment": "production",
    "tools": ["git", "terraform", "aws-cli", "github-actions", "docker"],
    "scale_params": {
      "min_runners": 2,
      "max_runners": 20,
      "scale_up_threshold_minutes": 2,
      "scale_down_idle_minutes": 15,
      "instance_type": "c6i.large"
    },
    "required_checks": ["runner-registered", "job-pickup-within-2min", "idle-termination"]
  },
  "risk_tolerance": "balanced",
  "replan_policy": "patch"
}