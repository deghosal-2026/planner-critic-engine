# PlannerCritic provider registry — copy this to plancritic.toml and set your API key

[roles]
planner = "local"
critic = "local"

[providers.local]
transport = "openai-compatible"
base_url = "https://openrouter.ai/api/v1"
model = "openai/gpt-4o-mini"
api_key = "${OPENROUTER_API_KEY}"
max_tokens = 16384
timeout_s = 300.0

