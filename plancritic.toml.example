# PlannerCritic provider registry — copy this to plancritic.toml and set your API key

[roles]
planner = "local"
critic = "local"

[providers.local]
transport = "openai-compatible"
base_url = "https://openrouter.ai/api/v1"
model = "openai/gpt-4o-mini"
api_key = "${OPENROUTER_API_KEY}"
max_tokens = 16384
timeout_s = 300.0

# For the critic/planner capability tier split (#257), define separate
# providers for each role to use different model tiers:
#
# [roles]
# planner = "fast"
# critic = "capable"
#
# [providers.fast]
# transport = "openai-compatible"
# base_url = "https://openrouter.ai/api/v1"
# model = "openai/gpt-4o-mini"    # cheap, fast
# api_key = "${OPENROUTER_API_KEY}"
# max_tokens = 8192
#
# [providers.capable]
# transport = "openai-compatible"
# base_url = "https://openrouter.ai/api/v1"
# model = "openai/gpt-4o"         # stronger, more expensive
# api_key = "${OPENROUTER_API_KEY}"
# max_tokens = 16384

